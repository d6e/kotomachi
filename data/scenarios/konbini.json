        { "text": "$item を ください 。", "gloss": "Give me $item_en.", "result": "npc_puzzled", "reaction": "えっと 、 $item は あちら です よ 。", "note": "At a konbini you pick things up yourself and bring them to the register."}
      ],
      "next": { "success": "heat" }
    },
    "heat": {
